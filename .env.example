# Backend database. SQLite is acceptable for small deployments; PostgreSQL is recommended for production.
DATABASE_URL=sqlite:///./gift.db

# Required. Set a long unique value; the insecure admin123 default is not supported.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional but recommended. Used to sign admin bearer tokens; if omitted ADMIN_PASSWORD is used.
ADMIN_TOKEN_SECRET=change-me-to-a-different-long-random-secret

# Comma-separated browser origins allowed to call the API. Do not use * in production.
CORS_ORIGINS=https://example.com,https://www.example.com

# Gift lock timeout and regret limit.
LOCK_TIMEOUT_MINUTES=15
MAX_REGRET_CHANCES=1
